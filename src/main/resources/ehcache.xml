<?xml version="1.0" encoding="UTF-8"?>
<config
        xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.ehcache.org/v3
            http://www.ehcache.org/schema/ehcache-core.xsd">

    <!-- Application Parameters -->
    <cache alias="application_parameter">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.String</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <!-- User Cache -->
    <cache alias="app_user_by_username">
        <key-type>java.lang.String</key-type>
        <value-type>com.fasa.orders.entity.AppUserEntity</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- All Products -->
    <cache alias="products">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Low Stock Products -->
    <cache alias="lowStockProducts">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.ArrayList</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Product By Name And Id -->
    <cache alias="productByNameAndId">
        <key-type>java.lang.String</key-type>
        <value-type>java.util.Optional</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>
    <cache alias="shippingRatePrice">
        <key-type>java.lang.String</key-type>
        <value-type>java.math.BigDecimal</value-type>
        <expiry>
            <ttl unit="minutes">1440</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>
</config>